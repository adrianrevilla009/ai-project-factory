{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adrianrevilla009/ai-project-factory/gates/approval-record.schema.json",
  "title": "Gate approval record",
  "description": "Registro de visto bueno humano de un gate. Lo crea una persona, nunca un agente.",
  "type": "object",
  "additionalProperties": false,
  "required": ["gate", "decision", "approver", "timestamp", "checklist_ref", "factory_version"],
  "properties": {
    "gate": { "type": "integer", "minimum": 0, "maximum": 5 },
    "decision": { "enum": ["approved", "approved_with_conditions", "rejected"] },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "contact": { "type": "string" }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "checklist_ref": { "type": "string", "description": "Ruta del checklist evaluado" },
    "factory_version": { "type": "string" },
    "conditions": { "type": "array", "items": { "type": "string" } },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "justification"],
        "properties": {
          "item": { "type": "string" },
          "justification": { "type": "string", "minLength": 1 },
          "expires": { "type": "string", "format": "date" }
        }
      }
    },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  },
  "allOf": [
    { "if": { "properties": { "decision": { "const": "approved_with_conditions" } } },
      "then": { "required": ["conditions"], "properties": { "conditions": { "minItems": 1 } } } },
    { "if": { "properties": { "gate": { "const": 0 } } },
      "then": { "required": ["domain_validated_by", "compliance_validated_by"],
        "properties": {
          "domain_validated_by": { "type": "string", "minLength": 1 },
          "compliance_validated_by": { "type": "string", "minLength": 1 } } } }
  ]
}
